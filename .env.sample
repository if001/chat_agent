# Bot identity
BOT_ID=ao
DISCORD_BOT_USER_ID=
ALLOWED_BOT_USER_IDS=
MENTION_CHANNEL_ID=replace_with_mention_channel_id
# `start:ingest` を動かす環境で設定
INGEST_CHANNEL_ID=
QUEUE_DIR=data/queues

# Discord
DISCORD_BOT_TOKEN=replace_me

# Web tools backend
SIMPLE_CLIENT_BASE_URL=http://localhost:8000

# Postgres
POSTGRES_URL=postgresql://app_user:app_password@localhost:5432/chat_agent
# 初回セットアップ時のみ使用。未設定なら POSTGRES_URL を使用
ADMIN_POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/chat_agent

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_API_KEY=
OLLAMA_CHAT_MODEL=qwen3:8b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_EMBEDDING_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_DIMENSION=1024

# Memory background runner
MEMORY_CHUNK_SIZE_TURNS=6
MEMORY_CHUNK_OVERLAP_TURNS=2
MEMORY_POLICY_QUERY_HISTORY_TURNS=4
MEMORY_BACKGROUND_POLL_MS=5000
MEMORY_BACKGROUND_THREAD_LIMIT=50
MEMORY_BACKGROUND_TURN_LIMIT_PER_THREAD=200
MEMORY_BACKGROUND_EPISODE_LIMIT=50
MEMORY_BACKGROUND_POLICY_LIMIT=50

RELATIONSHIP_STORE_DIR=data/relationship-system
SIMPLE_POMDP_STORE_DIR=data/simple-pomdp-system
SIMPLE_POMDP_INITIAL_DOMAIN_CANDIDATES_FILE=packages/simple-pomdp-system/domains/initial_domains.txt
SIMPLE_POMDP_THREAD_IDS=replace_with_thread_id
SIMPLE_POMDP_USER_ID=discord-user
SIMPLE_POMDP_QUEUE_FILE=data/queues/ao.json
SIMPLE_POMDP_BACKGROUND_POLL_MS=60000
SIMPLE_POMDP_RECENT_TURN_LIMIT=12
SIMPLE_POMDP_INTERACTION_LOG_LIMIT=20
SIMPLE_POMDP_OBSERVE_WINDOW_TURNS=3
SIMPLE_POMDP_PENDING_TIMEOUT_MS=21600000
SIMPLE_POMDP_DISPATCH_COOLDOWN_MS=3600000
SIMPLE_POMDP_MAX_PENDING_INTERACTIONS=1
SIMPLE_POMDP_INTERACTION_START_HOUR=10
SIMPLE_POMDP_INTERACTION_END_HOUR=24
SIMPLE_POMDP_MAX_TURNS_PER_THREAD=200
SIMPLE_POMDP_MAX_LOGS_PER_USER=200
SIMPLE_POMDP_LLM_CACHE_TTL_MS=86400000
SIMPLE_POMDP_QUEUE_DEBUG_LOG_FILE=

# DeepAgent skills
DEEPAGENT_SKILLS_SOURCES=/src/skills/
