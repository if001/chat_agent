{
  "name": "chat_agent",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev2": "tsx src/sample.mts",
    "dev": "tsx watch src/index.ts",
    "start:terminal": "tsx --env-file=.env.ao src/runTerminal.ts",
    "start:ao": "tsx --env-file=.env.ao src/runDiscord.ts",
    "start:aka": "tsx --env-file=.env.aka src/runDiscord.ts",
    "start:ingest": "tsx --env-file=.env.ao src/runIngest.ts",
    "start:simple-pomdp": "tsx --env-file=.env.ao packages/simple-pomdp-system/src/cli/runBackground.ts",
    "build": "tsc -p .",
    "build:live": "nodemon --watch 'src/**/*.ts' --exec \"ts-node\" src/index.ts",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:critical": "jest --runInBand src/ui/discord/discordBotApp.integration.test.ts src/infrastructure/discord/discordJsTransport.test.ts src/ui/discord/discordBotApp.test.ts src/queue/queueWorker.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "start:setup-memory": "tsx --env-file=.env.ao src/runSetupMemory.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.6.0",
    "@types/pg": "^8.20.0",
    "eslint": "^9.39.5",
    "globals": "^17.7.0",
    "jest": "^29.7.0",
    "jiti": "^2.7.0",
    "ts-jest": "^29.4.9",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0"
  },
  "dependencies": {
    "@chat-agent/knowledge-access": "file:packages/knowledge-access",
    "@chat-agent/memory-system": "file:packages/memory-system",
    "@chat-agent/queue": "file:packages/queue",
    "@chat-agent/simple-pomdp-system": "file:packages/simple-pomdp-system",
    "@langchain/langgraph-checkpoint-postgres": "^1.0.1",
    "@langchain/ollama": "^1.2.7",
    "deepagents": "^1.7.0",
    "discord.js": "^14.21.0",
    "dotenv": "^17.2.3",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.16.3"
  }
}
